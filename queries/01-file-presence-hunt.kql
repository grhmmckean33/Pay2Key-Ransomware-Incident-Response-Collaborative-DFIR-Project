// Portfolio reconstruction based on the documented scope-assessment method.
// Replace filenames and time range with authorised case indicators.
let SuspiciousFiles = dynamic(["Synaptics.exe", "massscan_gui.exe"]);
DeviceFileEvents
| where Timestamp between (datetime(2026-02-28) .. datetime(2026-03-31))
| where FileName in~ (SuspiciousFiles)
| project Timestamp, DeviceName, ActionType, FileName, FolderPath, SHA256, InitiatingProcessAccountName
| order by Timestamp asc
